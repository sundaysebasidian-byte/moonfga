///|
test "official CEL model and evaluation outcomes 8" {
  oracle_cases([
    (
      "size(bytes(\"\\t\\t中Z\\n\")) == 7", "{\"n\": 0, \"s\": \"\"}", "true", "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
    (
      "string(bytes(\"\\t\\t中Z\\n\")) == \"\\t\\t中Z\\n\"", "{\"n\": 0, \"s\": \"\"}",
      "true", "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
    (
      "1 < 2.0", "{\"n\": 0, \"s\": \"\"}", "M:invalid_authorization_model", "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
    (
      "1 + 2.0 == 3.0", "{\"n\": 0, \"s\": \"\"}", "M:invalid_authorization_model",
      "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
    (
      "1 == 1.0", "{\"n\": 0, \"s\": \"\"}", "M:invalid_authorization_model", "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
    (
      "1", "{\"n\": 0, \"s\": \"\"}", "M:invalid_authorization_model", "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
    (
      "missing == 1", "{\"n\": 0, \"s\": \"\"}", "M:invalid_authorization_model",
      "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
