    ),
    (
      "dyn(9223372036854775807) >= dyn(0.0)", "{\"n\": 0, \"s\": \"\"}", "true",
      "{\"n\": {\"type_name\": \"TYPE_NAME_INT\"}, \"s\": {\"type_name\": \"TYPE_NAME_STRING\"}}",
    ),
  ]
  for (source, context, expected, params_json) in cases {
    let params : Array[@fga.ConditionParam] = []
    match @json.parse(params_json) {
      Object(m) =>
        m.each((name, value) => {
          let (base, inner) = oracle_parameter(value)
          params.push({ name, type_name: base, generic_type: inner, })
        })
      _ => abort("bad parameter fixture")
    }
    let condition : @fga.Condition = {
      name: "cel_condition",
      expression: source,
      parameters: params,
    }
    let valid = try {
      @cel.check_condition(condition)
      true
    } catch {
      _ => false
    }
    let actual = if @utf8.encode(source[:]).length() > 512 {
      "M:validation_error"
    } else if !valid {
      "M:invalid_authorization_model"
    } else {
      try {
        let fields = match @json.parse(context) {
          Object(m) => m
          _ => abort("invalid fixture context")
        }
        @cel.eval_condition(condition, fields).to_string()
      } catch {
        _ => "E2000"
      }
    }
    assert_eq(actual, expected, msg=source + " context=" + context)
  }
}

///|
fn oracle_parameter(value : Json) -> (String, String?) {
  let name = @fga.json_get_string(value, "type_name").unwrap()
  let base = match name {
    "TYPE_NAME_INT" => "int"
    "TYPE_NAME_UINT" => "uint"
    "TYPE_NAME_DOUBLE" => "double"
    "TYPE_NAME_ANY" => "any"
    "TYPE_NAME_LIST" => "list"
    "TYPE_NAME_MAP" => "map"
    "TYPE_NAME_STRING" => "string"
    "TYPE_NAME_BOOL" => "bool"
    "TYPE_NAME_TIMESTAMP" => "timestamp"
    "TYPE_NAME_DURATION" => "duration"
    _ => abort("unsupported fixture type")
  }
  let generics = @fga.json_get_array(value, "generic_types")
  let inner = if generics.is_empty() {
    None
  } else {
    let (b, t) = oracle_parameter(generics[0])
    Some(
      b +
      (match t {
        None => ""
        Some(t) => "<" + t + ">"
      }),
    )
  }
  (base, inner)
}
