///|
fn cost_cases(cases : Array[(String, String, Int32)]) -> Unit raise {
  for (source, context, expected) in cases {
    let fields = match @json.parse(context) {
      Object(m) => m
      _ => abort("invalid cost context")
    }
    let env : Map[String, @fga.CelValue] = Map([])
    fields.each(fn(k, v) {
      env[k] = if k == "n" {
        match v {
          Number(x, ..) => @fga.VInt(x.to_int64())
          _ => abort("invalid n")
        }
      } else {
        @fga.json_to_cel_value_raw(v)
      }
    })
    let expr = @cel.compile(source)
    let (_, cost) = @cel.eval_expr_with_cost(expr, env, 2147483647)
    assert_eq(cost, expected, msg=source)
    ignore(@cel.eval_expr_with_limit(expr, env, expected))
    if expected > 0 {
      let exceeded = try {
        ignore(@cel.eval_expr_with_limit(expr, env, expected - 1))
        false
      } catch {
        e => @fga.error_message(e).contains("cost limit exceeded")
      }
      assert_true(exceeded, msg=source)
    }
  }
}
