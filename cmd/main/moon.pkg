pkgtype(kind: "executable")

import {
  "sundaysebasidian-byte/moonfga/host",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "moonbit-community/yaml",
  "sundaysebasidian-byte/moonfga/fga",
  "sundaysebasidian-byte/moonfga/dsl",
  "sundaysebasidian-byte/moonfga/model",
  "sundaysebasidian-byte/moonfga/store",
  "sundaysebasidian-byte/moonfga/engine",
  "sundaysebasidian-byte/moonfga/validate",
  "sundaysebasidian-byte/moonfga/storetest",
}

options(
  targets: {
    "env_js.mbt": [ "js" ],
    "env_other.mbt": [ "native", "wasm", "wasm-gc" ],
  },
)
